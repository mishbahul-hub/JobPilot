# Copy to .env and fill in. Never commit .env.

# Local docker-compose default. For Neon/Supabase paste their connection string.
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot

# https://aistudio.google.com/apikey  (Gemini: chat model + gemini-embedding-001)
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=["gemini-3.1-flash-lite","gemini-3.8-flash"]

# https://developer.adzuna.com  (free key; country "in" = India)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
LOG_LEVEL=INFO
